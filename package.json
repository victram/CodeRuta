{
  "name": "coderuta",
  "version": "0.2.0",
  "private": true,
  "description": "Aprende a programar paso a paso: rutas, lecciones, ejercicios y exámenes.",
  "author": "CodeRuta",
  "main": "desktop/main.cjs",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "icon": "electron desktop/make-icon.cjs"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.coderuta.app",
    "productName": "CodeRuta",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "desktop/main.cjs",
      "server/package.json",
      "server/src/**",
      "client/dist/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CodeRuta",
      "artifactName": "CodeRuta-Setup-${version}.${ext}"
    }
  }
}
